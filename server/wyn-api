def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default

def write_json(path, obj, mode=0o600):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(obj, f)
    os.replace(tmp, path)
    os.chmod(path, mode)

def scrypt(password, salt):
    return hashlib.scrypt(password.encode("utf-8"), salt=salt, n=2 ** 14, r=8, p=1, dklen=32)

def totp(secret_b32, step):
    key = base64.b32decode(secret_b32)
    h = hmac.new(key, struct.pack(">Q", step), "sha1").digest()
    o = h[-1] & 15
    return "%06d" % ((struct.unpack(">I", h[o:o + 4])[0] & 0x7FFFFFFF) % 1000000)

def sha(s):
    return hashlib.sha256(s.encode()).hexdigest()


# ---------- login protection ----------
class Guard:
    """Slows down password guessing: per visitor and for the whole site."""
    def __init__(self):
        self.ip = {}
        self.all = []

    def blocked(self, ip):
        now = time.time()
        self.all = [t for t in self.all if now - t < 900]
        v = [t for t in self.ip.get(ip, []) if now - t < 900]
        self.ip[ip] = v
        return len(v) >= 5 or len(self.all) >= 25

    def fail(self, ip):
        now = time.time()
        self.ip.setdefault(ip, []).append(now)
        self.all.append(now)

    def ok(self, ip):
        self.ip.pop(ip, None)


