    def db(self):
        c = sqlite3.connect(self.path, timeout=10)
        c.row_factory = sqlite3.Row
        c.execute("PRAGMA journal_mode=WAL")
        return c

    def signup(self, name, email, password, state):
        name, email = name.strip(), email.strip().lower()
        if not NAME_RE.match(name):
            return None, "Username needs 3 to 20 letters, numbers or underscores."
        if name.lower() in RESERVED:
            return None, "That username is not available. Try another one."
        if not EMAIL_RE.match(email):
            return None, "Please enter a valid email address."
        if len(password) < 8:
            return None, "Your password needs at least 8 characters."
        if len(password) > 200:
            return None, "That password is too long."
        salt = secrets.token_bytes(16)
        h = scrypt(password, salt)
        st = clean_state(state)
        now = time.time()
        db = self.db()
        try:
            if db.execute("SELECT 1 FROM players WHERE email=?", (email,)).fetchone():
                return None, "That email already has an account. Try logging in."
            if db.execute("SELECT 1 FROM players WHERE name_l=?", (name.lower(),)).fetchone():
                return None, "That username is taken. Try another one."
            cur = db.execute("INSERT INTO players(name,name_l,email,salt,hash,created,last_login,state,ver,upd) VALUES(?,?,?,?,?,?,?,?,?,?)",
                             (name, name.lower(), email, salt, h, now, now, json.dumps(st) if st else None, 1 if st else 0, now))
            db.commit()
            return cur.lastrowid, None
        except sqlite3.IntegrityError:
            return None, "That username or email is already used."
        finally:
            db.close()

    def check_login(self, ident, password):
        ident = ident.strip().lower()
        db = self.db()
        try:
            r = db.execute("SELECT * FROM players WHERE email=? OR name_l=?", (ident, ident)).fetchone()
            salt = bytes(r["salt"]) if r else b"\0" * 16
            h = scrypt(password, salt)
            if r and not r["banned"] and hmac.compare_digest(h, bytes(r["hash"])):
                db.execute("UPDATE players SET last_login=? WHERE id=?", (time.time(), r["id"]))
                db.commit()
                return r["id"]
            return None
        finally:
            db.close()

    def new_session(self, pid):
        tok = secrets.token_urlsafe(32)
        now = time.time()
        db = self.db()
        db.execute("DELETE FROM psessions WHERE idle<? OR mx<?", (now, now))
        db.execute("INSERT INTO psessions(h,pid,idle,mx) VALUES(?,?,?,?)", (sha(tok), pid, now + PSESSION_IDLE, now + PSESSION_MAX))
        db.commit()
        db.close()
        return tok

    def session_player(self, tok):
        if not tok:
            return None
        now = time.time()
        db = self.db()
        try:
            s = db.execute("SELECT * FROM psessions WHERE h=?", (sha(tok),)).fetchone()
            if not s or s["idle"] < now or s["mx"] < now:
                return None
            p = db.execute("SELECT * FROM players WHERE id=? AND banned=0", (s["pid"],)).fetchone()
            if not p:
                return None
            db.execute("UPDATE psessions SET idle=? WHERE h=?", (min(now + PSESSION_IDLE, s["mx"]), s["h"]))
            db.commit()
            return dict(p)
        finally:
            db.close()

    def end_session(self, tok):
        db = self.db()
        db.execute("DELETE FROM psessions WHERE h=?", (sha(tok or ""),))
        db.commit()
        db.close()

    def make_reset(self, email):
        """Returns (name, token) for an existing, not-banned account, else None."""
        db = self.db()
        try:
            r = db.execute("SELECT id,name FROM players WHERE email=? AND banned=0", (email.strip().lower(),)).fetchone()
            if not r:
                return None
            tok = secrets.token_urlsafe(32)
            db.execute("DELETE FROM resets WHERE exp<?", (time.time(),))
            db.execute("INSERT INTO resets(h,pid,exp) VALUES(?,?,?)", (sha(tok), r["id"], time.time() + 3600))
            db.commit()
            return r["name"], tok
        finally:
            db.close()

    def use_reset(self, tok, password):
        if len(password) < 8:
            return "Your password needs at least 8 characters."
        if len(password) > 200:
            return "That password is too long."
        db = self.db()
        try:
            r = db.execute("SELECT * FROM resets WHERE h=?", (sha(tok),)).fetchone()
            if not r or r["used"] or r["exp"] < time.time():
                return "This reset link has expired or was already used. Please ask for a new one."
            salt = secrets.token_bytes(16)
            db.execute("UPDATE players SET salt=?, hash=? WHERE id=?", (salt, scrypt(password, salt), r["pid"]))
            db.execute("UPDATE resets SET used=1 WHERE h=?", (r["h"],))
            db.execute("DELETE FROM psessions WHERE pid=?", (r["pid"],))
            db.commit()
            return None
        finally:
            db.close()

    def name_free(self, name):
        n = name.strip().lower()
        if not NAME_RE.match(name.strip()) or n in RESERVED:
            return False
        db = self.db()
        try:
            return db.execute("SELECT 1 FROM players WHERE name_l=?", (n,)).fetchone() is None
        finally:
            db.close()

    def save_state(self, pid, state, ver):
        st = clean_state(state)
        if not st:
            return False, None, None
        db = self.db()
        try:
            cur = db.execute("UPDATE players SET state=?, ver=ver+1, upd=? WHERE id=? AND ver=?", (json.dumps(st), time.time(), pid, ver))
            db.commit()
            if cur.rowcount == 1:
                return True, ver + 1, None
            r = db.execute("SELECT state, ver FROM players WHERE id=?", (pid,)).fetchone()
            return False, r["ver"], (json.loads(r["state"]) if r["state"] else None)
        finally:
            db.close()

    # ----- support chat (player <-> team), same on every device -----
    CHAT_MODES = ("ai", "wait", "human", "closed")

    def _bump(self, db, pid):
        db.execute("UPDATE meta SET v=v+1 WHERE k='chatseq'")
        seq = db.execute("SELECT v FROM meta WHERE k='chatseq'").fetchone()[0]
        db.execute("INSERT OR IGNORE INTO chat_threads(pid) VALUES(?)", (pid,))
        db.execute("UPDATE chat_threads SET seq=?, upd=? WHERE pid=?", (seq, time.time(), pid))
        return seq

    def _clean_msg(self, m, allowed):
        if not isinstance(m, dict) or m.get("f") not in allowed:
            return None
        x = str(m.get("x", ""))[: (500 if m.get("f") == "u" else 1500)]
        if not x.strip():
            return None
        ex = m.get("extra")
        if isinstance(ex, dict):
            ex = {k: ex[k] for k in ("links", "offer") if k in ex}
            ex = json.dumps(ex) if ex and len(json.dumps(ex)) <= 1500 else None
        else:
            ex = None
        try:
            t = float(m.get("t"))
        except Exception:
            t = time.time() * 1000
        t = min(max(t, 0), time.time() * 1000 + 60000)
        return (m["f"], t, x, ex)

    def _thread_out(self, db, pid, full=True):
        th = db.execute("SELECT * FROM chat_threads WHERE pid=?", (pid,)).fetchone()
        if not th:
            return {"mode": "ai", "ru": 0, "ra": 0, "seq": 0, "msgs": []}
        rows = db.execute("SELECT id,f,t,x,extra FROM chat_msgs WHERE pid=? ORDER BY id DESC LIMIT 200", (pid,)).fetchall()[::-1]
        msgs = []
        for r in rows:
            m = {"sid": r["id"], "f": r["f"], "t": r["t"], "x": r["x"]}
            if r["extra"]:
                m.update(json.loads(r["extra"]))
            msgs.append(m)
        return {"mode": th["mode"], "ru": th["ru"], "ra": th["ra"], "seq": th["seq"], "msgs": msgs}

    def chat_player_sync(self, pid, seq, add, mode, read):
        db = self.db()
        try:
            th = db.execute("SELECT * FROM chat_threads WHERE pid=?", (pid,)).fetchone()
            changed = False
            cur = th["mode"] if th else "ai"
            ra, ru = (th["ra"], th["ru"]) if th else (0, 0)
            rows = []
            for m in (add if isinstance(add, list) else [])[:30]:
                c = self._clean_msg(m, ("u", "b", "s"))
                if c:
                    rows.append(c)
            if rows or (mode in ("ai", "wait", "human") and mode != cur) or (read and ru):
                if rows and not self.chat_msg_lim.hit(pid):
                    return {"error": "slow"}
                new_mode = mode if mode in ("ai", "wait", "human") else cur
                if new_mode == "wait" and cur not in ("wait", "human"):
                    ra += 1
                if cur in ("wait", "human"):
                    ra += sum(1 for r in rows if r[0] == "u")
                if cur == "closed" and any(r[0] == "u" for r in rows) and new_mode == "closed":
                    new_mode = "ai"
                if read:
                    ru = 0
                db.execute("INSERT OR IGNORE INTO chat_threads(pid) VALUES(?)", (pid,))
                db.execute("UPDATE chat_threads SET mode=?, ru=?, ra=? WHERE pid=?", (new_mode, ru, ra, pid))
                for r in rows:
                    db.execute("INSERT INTO chat_msgs(pid,f,t,x,extra) VALUES(?,?,?,?,?)", (pid, r[0], r[1], r[2], r[3]))
                self._bump(db, pid)
                db.commit()
                changed = True
            th2 = db.execute("SELECT seq FROM chat_threads WHERE pid=?", (pid,)).fetchone()
            cur_seq = th2["seq"] if th2 else 0
            if not changed and seq == cur_seq:
                return {"unchanged": True, "seq": cur_seq}
            return self._thread_out(db, pid)
        finally:
            db.close()

    def chat_admin_sync(self, since, add, modes):
        db = self.db()
        try:
            def pid_of(em):
                r = db.execute("SELECT id FROM players WHERE email=?", (str(em).strip().lower(),)).fetchone()
                return r["id"] if r else None
            touched = set()
            for m in (add if isinstance(add, list) else [])[:50]:
                pid = pid_of(m.get("em", "")) if isinstance(m, dict) else None
                c = self._clean_msg(m, ("a", "s")) if pid else None
                if not c:
                    continue
                db.execute("INSERT OR IGNORE INTO chat_threads(pid) VALUES(?)", (pid,))
                db.execute("INSERT INTO chat_msgs(pid,f,t,x,extra) VALUES(?,?,?,?,?)", (pid, c[0], c[1], c[2], c[3]))
                if c[0] == "a":
                    db.execute("UPDATE chat_threads SET ru=ru+1, ra=0, mode=CASE WHEN mode='closed' THEN 'closed' ELSE 'human' END WHERE pid=?", (pid,))
                touched.add(pid)
            for em, md in (modes.items() if isinstance(modes, dict) else []):
                pid = pid_of(em)
                if pid and md in self.CHAT_MODES:
                    db.execute("INSERT OR IGNORE INTO chat_threads(pid) VALUES(?)", (pid,))
                    db.execute("UPDATE chat_threads SET mode=?, ru=ru+? WHERE pid=?", (md, 0 if md == "closed" else 1, pid))
                    touched.add(pid)
            for pid in touched:
                self._bump(db, pid)
            db.commit()
            out = []
            top = db.execute("SELECT v FROM meta WHERE k='chatseq'").fetchone()[0]
            for r in db.execute("SELECT t.pid, t.seq, p.email, p.name FROM chat_threads t JOIN players p ON p.id=t.pid WHERE t.seq>? ORDER BY t.seq LIMIT 300", (since,)).fetchall():
                d = self._thread_out(db, r["pid"])
                d["em"], d["n"] = r["email"], r["name"]
                out.append(d)
            return {"threads": out, "seq": top}
        finally:
            db.close()

    # ----- wallet (real money ledger, amounts in cents) -----
    ADDR = {
        "btc": re.compile(r"^(bc1[a-z0-9]{25,62}|[13][a-km-zA-HJ-NP-Z1-9]{25,34})$"),
        "evm": re.compile(r"^0x[a-fA-F0-9]{40}$"),
        "tron": re.compile(r"^T[1-9A-HJ-NP-Za-km-z]{33}$"),
        "sol": re.compile(r"^[1-9A-HJ-NP-Za-km-z]{32,44}$"),
    }
    DEFAULTS = {"real_deposits": 0, "real_withdrawals": 0, "min_deposit": 20, "min_withdraw": 20, "coins": []}

    def wdb(self):
        c = sqlite3.connect(self.path, timeout=15, isolation_level=None)
        c.row_factory = sqlite3.Row
        c.execute("PRAGMA journal_mode=WAL")
        return c

    def settings(self, db=None):
        own = db is None
        db = db or self.db()
        try:
            out = dict(self.DEFAULTS)
            for r in db.execute("SELECT k,v FROM settings"):
                try:
                    out[r["k"]] = json.loads(r["v"])
                except Exception:
                    pass
            return out
        finally:
            if own:
                db.close()

    def audit(self, db, who, action, detail):
        db.execute("INSERT INTO audit(ts,who,action,detail) VALUES(?,?,?,?)", (time.time(), who, action, json.dumps(detail)[:2000]))

    @staticmethod
    def cents(v, lo=0, hi=10_000_000):
        try:
            d = Decimal(str(v).strip()).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
        except (InvalidOperation, ValueError):
            return None
        c = int(d * 100)
        return c if lo < c <= hi * 100 else None

    def _post(self, db, pid, kind, cents, ref="", note=""):
        """Adds one ledger line and moves the balance in the same step. Call inside BEGIN IMMEDIATE."""
        r = db.execute("SELECT real_cents FROM players WHERE id=?", (pid,)).fetchone()
        nb = r["real_cents"] + cents
        if nb < 0:
            raise ValueError("not enough balance")
        db.execute("UPDATE players SET real_cents=? WHERE id=?", (nb, pid))
        db.execute("INSERT INTO wallet_ledger(pid,kind,cents,bal_after,ref,note,created) VALUES(?,?,?,?,?,?,?)", (pid, kind, cents, nb, ref, note[:300], time.time()))
        return nb

    def wallet_view(self, pid):
        db = self.db()
        try:
            st = self.settings(db)
            p = db.execute("SELECT real_cents FROM players WHERE id=?", (pid,)).fetchone()
            coins = [{k: c.get(k) for k in ("id", "label", "network", "address", "addr_type")} for c in st["coins"] if c.get("enabled") and c.get("address")] if st["real_deposits"] or st["real_withdrawals"] else []
            deps = [dict(r) for r in db.execute("SELECT id,coin,network,claimed_cents,txid,status,credited_cents,created,admin_note FROM deposits WHERE pid=? ORDER BY id DESC LIMIT 20", (pid,))]
            wds = [dict(r) for r in db.execute("SELECT id,coin,network,address,cents,status,txid,created,admin_note FROM withdrawals WHERE pid=? ORDER BY id DESC LIMIT 20", (pid,))]
            led = [dict(r) for r in db.execute("SELECT kind,cents,bal_after,note,created FROM wallet_ledger WHERE pid=? ORDER BY id DESC LIMIT 30", (pid,))]
            return {"real_cents": p["real_cents"], "config": {"real_deposits": bool(st["real_deposits"]), "real_withdrawals": bool(st["real_withdrawals"]),
                    "min_deposit": st["min_deposit"], "min_withdraw": st["min_withdraw"], "coins": coins}, "deposits": deps, "withdrawals": wds, "ledger": led}
        finally:
            db.close()

    # ---------- boxes: the server decides every result ----------
    def boxes(self):
        """Box list shipped with the site (data/boxes.json). Reloads itself when the file changes."""
        try:
            mt = os.path.getmtime(self.box_file)
        except OSError:
            return self._boxes["d"]
        if mt != self._boxes["mt"]:
            raw = json.load(open(self.box_file))
            d = {}
            for b in raw:
                its = [(str(x[0])[:120], str(x[1])[:60], int(round(float(x[2]) * 100)), float(x[3])) for x in b["i"]]
                if its and all(i[3] > 0 and i[2] >= 0 for i in its):
                    d[str(b["n"])] = {"p": int(round(float(b["p"]) * 100)), "i": its}
            self._boxes = {"mt": mt, "d": d}
        return self._boxes["d"]

    @staticmethod
    def _pick(items, r):
        t = sum(i[3] for i in items)
        v = r * t
        for k, it in enumerate(items):
            v -= it[3]
            if v < 0:
                return k
        return len(items) - 1

    @staticmethod
    def _tier(idx, n):
        return min(4, (idx * 5) // n)

    def _fair(self, db, pid):
        r = db.execute("SELECT * FROM fair WHERE pid=?", (pid,)).fetchone()
        if not r:
            db.execute("INSERT INTO fair(pid,seed,cs,nonce) VALUES(?,?,?,0)", (pid, secrets.token_hex(16), "wyn-" + secrets.token_hex(4)))
            r = db.execute("SELECT * FROM fair WHERE pid=?", (pid,)).fetchone()
        return r

    @staticmethod
    def _fair_out(r):
        return {"commit": hashlib.sha256(r["seed"].encode()).hexdigest(), "cs": r["cs"], "nonce": r["nonce"], "last": json.loads(r["last"]) if r["last"] else None}

    def fair_view(self, pid):
        db = self.wdb()
        try:
            db.execute("BEGIN IMMEDIATE")
            r = self._fair(db, pid)
            db.execute("COMMIT")
            return self._fair_out(r)
        finally:
            db.close()

    def fair_set_cs(self, pid, cs):
        cs = str(cs or "")
        if not re.fullmatch(r"[A-Za-z0-9_-]{1,32}", cs):
            return None, "Use 1 to 32 letters, numbers, - or _."
        db = self.wdb()
        try:
            db.execute("BEGIN IMMEDIATE")
            self._fair(db, pid)
            db.execute("UPDATE fair SET cs=? WHERE pid=?", (cs, pid))
            r = self._fair(db, pid)
            db.execute("COMMIT")
            return self._fair_out(r), None
        finally:
            db.close()

    @staticmethod
    def _item_out(r):
        return {"id": "s%d" % r["id"], "n": r["name"], "k": r["icon"], "v": r["value_cents"] / 100.0, "r": r["rar"], "b": r["bname"], "t": int(r["created"] * 1000), "sh": int(r["ship"] * 1000) if r["ship"] else 0}

    def open_box(self, pid, bname):
        b = self.boxes().get(str(bname))
        if not b:
            return None, "That box is not available right now. Please refresh the page."
        db = self.wdb()
        try:
            db.execute("BEGIN IMMEDIATE")
            f = self._fair(db, pid)
            h = hashlib.sha256(("%s:%s:%d" % (f["seed"], f["cs"], f["nonce"])).encode()).hexdigest()
            roll = int(h[:8], 16) / 4294967296
            idx = self._pick(b["i"], roll)
            it = b["i"][idx]
            try:
                self._post(db, pid, "box", -b["p"], "B:" + str(bname)[:60], "Opened " + str(bname))
            except ValueError:
                db.execute("ROLLBACK")
                return None, "Not enough funds. Add funds and try again."
            now = time.time()
            rar = self._tier(idx, len(b["i"]))
            cur = db.execute("INSERT INTO items(pid,bname,name,icon,value_cents,rar,created) VALUES(?,?,?,?,?,?,?)", (pid, str(bname), it[0], it[1], it[2], rar, now))
            iid = cur.lastrowid
            db.execute("INSERT INTO opens(pid,bname,price_cents,item_idx,item_id,roll,nonce,ts) VALUES(?,?,?,?,?,?,?,?)", (pid, str(bname), b["p"], idx, iid, roll, f["nonce"], now))
            last = {"seed": f["seed"], "cs": f["cs"], "nonce": f["nonce"], "roll": roll, "commit": hashlib.sha256(f["seed"].encode()).hexdigest()}
            db.execute("UPDATE fair SET seed=?, nonce=nonce+1, last=? WHERE pid=?", (secrets.token_hex(16), json.dumps(last), pid))
            f2 = self._fair(db, pid)
            row = db.execute("SELECT * FROM items WHERE id=?", (iid,)).fetchone()
            db.execute("COMMIT")
        except Exception:
            try:
                db.execute("ROLLBACK")
            except Exception:
                pass
            raise
        finally:
            db.close()
        return {"ok": True, "idx": idx, "item": self._item_out(row), "roll": roll, "fair": self._fair_out(f2), "wallet": self.wallet_view(pid)}, None

    def sell_item(self, pid, sid):
        m = re.fullmatch(r"s(\d{1,12})", str(sid))
        if not m:
            return None, "That item was not found."
        db = self.wdb()
        try:
            db.execute("BEGIN IMMEDIATE")
            r = db.execute("SELECT * FROM items WHERE id=? AND pid=?", (int(m.group(1)), pid)).fetchone()
            if not r or r["status"] != "held":
                db.execute("ROLLBACK")
                return None, "That item was already sold."
            if r["ship"]:
                db.execute("ROLLBACK")
                return None, "Cancel the shipment first to sell this item."
            db.execute("UPDATE items SET status='sold', sold=? WHERE id=?", (time.time(), r["id"]))
            self._post(db, pid, "sell", r["value_cents"], "I%d" % r["id"], "Sold " + r["name"])
            db.execute("COMMIT")
        except Exception:
            try:
                db.execute("ROLLBACK")
            except Exception:
                pass
            raise
        finally:
            db.close()
        return {"ok": True, "sold": r["value_cents"] / 100.0, "name": r["name"], "wallet": self.wallet_view(pid)}, None

    def ship_item(self, pid, sid, on):
        m = re.fullmatch(r"s(\d{1,12})", str(sid))
        if not m:
            return None, "That item was not found."
        db = self.wdb()
        try:
            db.execute("BEGIN IMMEDIATE")
            r = db.execute("SELECT * FROM items WHERE id=? AND pid=?", (int(m.group(1)), pid)).fetchone()
            if not r or r["status"] != "held":
                db.execute("ROLLBACK")
                return None, "That item was not found."
            db.execute("UPDATE items SET ship=? WHERE id=?", (time.time() if on else None, r["id"]))
            db.execute("COMMIT")
        finally:
            db.close()
        return {"ok": True}, None

    def items_view(self, pid):
        db = self.db()
        try:
            rows = db.execute("SELECT * FROM items WHERE pid=? AND status='held' ORDER BY id DESC LIMIT 500", (pid,)).fetchall()
            a = db.execute("SELECT COUNT(*) n, COALESCE(SUM(price_cents),0) sp FROM opens WHERE pid=?", (pid,)).fetchone()
            w = db.execute("SELECT COALESCE(SUM(value_cents),0) won FROM items WHERE pid=?", (pid,)).fetchone()
            sd = db.execute("SELECT COALESCE(SUM(value_cents),0) sold FROM items WHERE pid=? AND status='sold'", (pid,)).fetchone()
            best = db.execute("SELECT * FROM items WHERE pid=? ORDER BY value_cents DESC, id ASC LIMIT 1", (pid,)).fetchone()
            hist = [dict(r) for r in db.execute("SELECT kind,cents,note,created FROM wallet_ledger WHERE pid=? ORDER BY id DESC LIMIT 60", (pid,))]
            return {"items": [self._item_out(r) for r in rows],
                    "stats": {"opens": a["n"], "spent": a["sp"] / 100.0, "won": w["won"] / 100.0, "sold": sd["sold"] / 100.0,
                              "best": ({"n": best["name"], "k": best["icon"], "v": best["value_cents"] / 100.0, "r": best["rar"], "b": best["bname"]} if best else None)},
                    "hist": hist}
        finally:
            db.close()

    # ---------- games: the server decides every result ----------
    CR_WAIT = 2.4   # seconds between the bet and take-off (the countdown on screen)

    def games(self):
        try:
            mt = os.path.getmtime(self.games_file)
        except OSError:
            return self._games["d"]
        if mt != self._games["mt"]:
            self._games = {"mt": mt, "d": json.load(open(self.games_file))}
        return self._games["d"]

    def _run(self, fn):
        db = self.wdb()
        try:
            db.execute("BEGIN IMMEDIATE")
            try:
                out = fn(db)
            except GameErr as e:
                db.execute("ROLLBACK")
                return None, str(e)
            db.execute("COMMIT")
            return out, None
        except Exception:
            try:
                db.execute("ROLLBACK")
            except Exception:
                pass
            raise
        finally:
            db.close()

    def _gf(self, db, pid, game):
        r = db.execute("SELECT * FROM fair_g WHERE pid=? AND game=?", (pid, game)).fetchone()
        if not r:
            db.execute("INSERT INTO fair_g(pid,game,seed,cs,nonce) VALUES(?,?,?,?,0)", (pid, game, secrets.token_hex(16), "wyn-" + secrets.token_hex(4)))
            r = db.execute("SELECT * FROM fair_g WHERE pid=? AND game=?", (pid, game)).fetchone()
        return r

    @staticmethod
    def _gf_out(r):
        return {"commit": hashlib.sha256(r["seed"].encode()).hexdigest(), "cs": r["cs"], "nonce": r["nonce"], "last": json.loads(r["last"]) if r["last"] else None}

    def _gf_roll(self, db, pid, game, extra):
        """Reveals the seed used for this round, picks a fresh one for the next. Returns (used, new fair row)."""
        f = self._gf(db, pid, game)
        used = {"seed": f["seed"], "cs": f["cs"], "nonce": f["nonce"], "commit": hashlib.sha256(f["seed"].encode()).hexdigest()}
        used.update(extra)
        db.execute("UPDATE fair_g SET seed=?, nonce=nonce+1, last=? WHERE pid=? AND game=?", (secrets.token_hex(16), json.dumps(used), pid, game))
        return used, self._gf(db, pid, game)

    def game_fair(self, pid, game):
        if game not in ("plinko", "wheel", "gem", "crash", "battle", "upgrade"):
            return None, "Unknown game."
        return self._run(lambda db: self._gf_out(self._gf(db, pid, game)))

    @staticmethod
    def _pay(bet_cents, mult):
        return int((Decimal(bet_cents) * Decimal(repr(float(mult)))).quantize(Decimal(1), rounding=ROUND_HALF_UP))

    def _bet(self, v):
        c = self.cents(v, 100, 500000)
        if c is None:
            raise GameErr("Please enter a bet from $1 to $5,000.")
        return c

    def _stake(self, db, pid, cents, note):
        try:
            self._post(db, pid, "bet", -cents, "G", note)
        except ValueError:
            raise GameErr("Not enough funds for that bet. Add funds or lower it.")

    def _win(self, db, pid, game, bet, pay, mult, note):
        if pay > 0:
            self._post(db, pid, "win", pay, "G", note)
        db.execute("INSERT INTO plays(pid,game,bet_cents,pay_cents,mult,ts) VALUES(?,?,?,?,?,?)", (pid, game, bet, pay, mult, time.time()))

    def plinko_drop(self, pid, bet, rows, risk):
        tb = self.games().get("plinko", {})
        rows = str(rows)
        if rows not in tb or risk not in tb[rows]:
            return None, "Choose rows and risk again."
        n = int(rows)
        def go(db):
            b = self._bet(bet)
            f = self._gf(db, pid, "plinko")
            h = hashlib.sha256(("%s:%s:%d" % (f["seed"], f["cs"], f["nonce"])).encode()).hexdigest()
            path = [int(h[i * 2:i * 2 + 2], 16) & 1 for i in range(n)]
            k = sum(path)
            mult = tb[rows][risk][k]
            pay = self._pay(b, mult)
            self._stake(db, pid, b, "Wyn Drop bet")
            self._win(db, pid, "plinko", b, pay, mult, "Wyn Drop %gx" % mult)
            used, f2 = self._gf_roll(db, pid, "plinko", {"rows": n, "risk": risk, "slot": k, "mult": mult})
            return {"ok": True, "path": path, "slot": k, "mult": mult, "bet_cents": b, "payout_cents": pay, "fair": self._gf_out(f2)}
        out, err = self._run(go)
        if out:
            out["wallet"] = self.wallet_view(pid)
        return out, err

    def wheel_spin(self, pid, bet, n, risk):
        tb = self.games().get("wheel", {})
        n = str(n)
        if n not in tb or risk not in tb[n]:
            return None, "Choose the slots and risk again."
        vals = tb[n][risk]
        def go(db):
            b = self._bet(bet)
            f = self._gf(db, pid, "wheel")
            h = hashlib.sha256(("%s:%s:%d" % (f["seed"], f["cs"], f["nonce"])).encode()).hexdigest()
            idx = int(h[:8], 16) % int(n)
            mult = vals[idx]
            pay = self._pay(b, mult)
            self._stake(db, pid, b, "Wyn Wheel bet")
            self._win(db, pid, "wheel", b, pay, mult, "Wyn Wheel %gx" % mult)
            used, f2 = self._gf_roll(db, pid, "wheel", {"n": int(n), "risk": risk, "idx": idx, "mult": mult})
            return {"ok": True, "idx": idx, "mult": mult, "bet_cents": b, "payout_cents": pay, "fair": self._gf_out(f2)}
        out, err = self._run(go)
        if out:
            out["wallet"] = self.wallet_view(pid)
        return out, err

    # ----- Gem Hunt -----
    @staticmethod
    def _gem_shuffle(seed, cs, nonce):
        by = []
        for i in range(4):
            h = hashlib.sha256(("%s:%s:%d:%d" % (seed, cs, nonce, i)).encode()).hexdigest()
            by += [int(h[j:j + 2], 16) for j in range(0, len(h), 2)]
        a = list(range(25))
        p = 0
        for i in range(24, 0, -1):
            lim = (256 // (i + 1)) * (i + 1)
            b = by[p % len(by)]
            p += 1
            while b >= lim and p < len(by):
                b = by[p]
                p += 1
            j = b % (i + 1)
            a[i], a[j] = a[j], a[i]
        return a

    def _gem_end(self, db, pid, st, win):
        tb = self.games()["gem"][str(st["mines"])]
        k = len(st["picked"])
        mult = tb[k] if win and k > 0 else 0
        pay = self._pay(st["bet"], mult) if mult else 0
        f = self._gf(db, pid, "gem")
        bombs = self._gem_shuffle(f["seed"], f["cs"], f["nonce"])[:st["mines"]]
        self._win(db, pid, "gem", st["bet"], pay, mult, "Gem Hunt " + ("cash out %.2fx" % mult if win else "bomb"))
        used, f2 = self._gf_roll(db, pid, "gem", {"mines": st["mines"], "bombs": bombs, "picked": st["picked"], "mult": mult})
        db.execute("DELETE FROM rounds WHERE pid=? AND game='gem'", (pid,))
        return {"done": True, "win": bool(win), "mult": mult, "payout_cents": pay, "bombs": bombs, "fair": self._gf_out(f2)}

    def _gem_round(self, db, pid):
        r = db.execute("SELECT st FROM rounds WHERE pid=? AND game='gem'", (pid,)).fetchone()
        return json.loads(r["st"]) if r else None

    def gem_start(self, pid, bet, mines):
        tb = self.games().get("gem", {})
        try:
            m = int(mines)
        except (TypeError, ValueError):
            m = 0
        if str(m) not in tb:
            return None, "Choose how many bombs you want."
        def go(db):
            if self._gem_round(db, pid):
                raise GameErr("You already have a game in progress.")
            b = self._bet(bet)
            f = self._gf(db, pid, "gem")
            self._stake(db, pid, b, "Gem Hunt bet")
            st = {"bet": b, "mines": m, "picked": []}
            db.execute("INSERT OR REPLACE INTO rounds(pid,game,st) VALUES(?,?,?)", (pid, "gem", json.dumps(st)))
            return {"ok": True, "bet_cents": b, "mines": m, "fair": {"commit": self._gf_out(f)["commit"], "cs": f["cs"], "nonce": f["nonce"]}}
        out, err = self._run(go)
        if out:
            out["wallet"] = self.wallet_view(pid)
        return out, err

    def gem_pick(self, pid, i):
        try:
            i = int(i)
        except (TypeError, ValueError):
            i = -1
        if not 0 <= i < 25:
            return None, "Pick a tile on the board."
        def go(db):
            st = self._gem_round(db, pid)
            if not st:
                raise GameErr("No game in progress.")
            if i in st["picked"]:
                raise GameErr("That tile is already open.")
            f = self._gf(db, pid, "gem")
            bombs = self._gem_shuffle(f["seed"], f["cs"], f["nonce"])[:st["mines"]]
            if i in bombs:
                st["picked"].append(i)
                out = self._gem_end(db, pid, dict(st, picked=st["picked"][:-1]), False)
                out.update({"bomb": True, "i": i})
                return out
            st["picked"].append(i)
            k = len(st["picked"])
            tb = self.games()["gem"][str(st["mines"])]
            if k >= 25 - st["mines"]:
                out = self._gem_end(db, pid, st, True)
                out.update({"bomb": False, "i": i, "k": k})
                return out
            db.execute("UPDATE rounds SET st=? WHERE pid=? AND game='gem'", (json.dumps(st), pid))
            return {"done": False, "bomb": False, "i": i, "k": k, "mult": tb[k]}
        out, err = self._run(go)
        if out:
            out["wallet"] = self.wallet_view(pid)
        return out, err

    def gem_cash(self, pid):
        def go(db):
            st = self._gem_round(db, pid)
            if not st or not st["picked"]:
                raise GameErr("Open at least one tile before cashing out.")
            return self._gem_end(db, pid, st, True)
        out, err = self._run(go)
        if out:
            out["wallet"] = self.wallet_view(pid)
        return out, err

    def gem_leave(self, pid):
        """Player walked away: cash out if they have gems, otherwise give the bet back."""
        def go(db):
            st = self._gem_round(db, pid)
            if not st:
                return {"done": True, "none": True}
            if st["picked"]:
                return self._gem_end(db, pid, st, True)
            self._post(db, pid, "refund", st["bet"], "G", "Gem Hunt bet returned")
            db.execute("DELETE FROM rounds WHERE pid=? AND game='gem'", (pid,))
            return {"done": True, "refund": True}
        out, err = self._run(go)
        if out:
            out["wallet"] = self.wallet_view(pid)
        return out, err

    def gem_state(self, pid):
        db = self.db()
        try:
            r = db.execute("SELECT st FROM rounds WHERE pid=? AND game='gem'", (pid,)).fetchone()
            if not r:
                return {"active": False}
            st = json.loads(r["st"])
            tb = self.games()["gem"][str(st["mines"])]
            return {"active": True, "bet_cents": st["bet"], "mines": st["mines"], "picked": st["picked"], "mult": tb[len(st["picked"])]}
        finally:
            db.close()

    # ----- Crash (Flying Roadster) -----
    @staticmethod
    def _crash_point(h, cfg):
        r = int(h[:13], 16) / (2 ** 52)
        if r < cfg["edge"]:
            return 1.0
        c = math.floor((1 - cfg["edge"]) / (1 - r) * 100) / 100
        return float(min(cfg["max"], max(1, c)))

    def _crash_round(self, db, pid):
        r = db.execute("SELECT st FROM rounds WHERE pid=? AND game='crash'", (pid,)).fetchone()
        return json.loads(r["st"]) if r else None

    def _crash_finish(self, db, pid, st, mult):
        cfg = self.games()["crash"]
        pay = self._pay(st["bet"], mult) if mult else 0
        self._win(db, pid, "crash", st["bet"], pay, mult or 0, "Flying Roadster " + ("win (%.2fx)" % mult if mult else "crashed"))
        used, f2 = self._gf_roll(db, pid, "crash", {"cp": st["cp"], "cashed": mult or 0})
        db.execute("DELETE FROM rounds WHERE pid=? AND game='crash'", (pid,))
        return {"done": True, "cp": st["cp"], "cashed": mult or 0, "payout_cents": pay, "fair": self._gf_out(f2)}

    def _crash_resolve(self, db, pid, st, now, want_cash):
        """Decides what has happened by `now`. Returns a result dict if the round is over, or None if still flying."""
        cfg = self.games()["crash"]
        rate = cfg["rate"]
        t = now - st["t0"]
        cp = st["cp"]
        tcrash = (math.log(cp) / rate) if cp > 1 else 0.0
        auto = st.get("auto") or 0
        # automatic eject comes first if the roadster reaches it before crashing
        if auto and auto < cp:
            tauto = math.log(auto) / rate
            if t >= tauto:
                return self._crash_finish(db, pid, st, auto)
        if t >= tcrash:
            return self._crash_finish(db, pid, st, 0)
        if want_cash:
            if t < 0:
                raise GameErr("Wait for take-off.")
            m = math.floor(math.exp(rate * t) * 100) / 100
            m = max(1.0, m)
            return self._crash_finish(db, pid, st, m)
        return None

    def crash_start(self, pid, bet, auto):
        cfg = self.games().get("crash")
        if not cfg:
            return None, "This game is not available right now."
        try:
            au = float(auto or 0)
        except (TypeError, ValueError):
            au = 0
        if au and not (1.01 <= au <= cfg["max"]):
            return None, "Auto eject needs to be 1.01x or more."
        au = round(au, 2)
        def go(db):
            now = time.time()
            old = self._crash_round(db, pid)
            if old:
                if self._crash_resolve(db, pid, old, now, False) is None:
                    raise GameErr("You already have a round in progress.")
            b = self._bet(bet)
            f = self._gf(db, pid, "crash")
            h = hashlib.sha256(("%s:%s:%d" % (f["seed"], f["cs"], f["nonce"])).encode()).hexdigest()
            cp = self._crash_point(h, cfg)
            self._stake(db, pid, b, "Flying Roadster bet")
            st = {"bet": b, "auto": au, "cp": cp, "t0": now + self.CR_WAIT}
            db.execute("INSERT OR REPLACE INTO rounds(pid,game,st) VALUES(?,?,?)", (pid, "crash", json.dumps(st)))
            return {"ok": True, "bet_cents": b, "wait": self.CR_WAIT, "rate": cfg["rate"], "fair": {"commit": self._gf_out(f)["commit"], "cs": f["cs"], "nonce": f["nonce"]}}
        out, err = self._run(go)
        if out:
            out["wallet"] = self.wallet_view(pid)
        return out, err

    def crash_cash(self, pid):
        def go(db):
            st = self._crash_round(db, pid)
            if not st:
                raise GameErr("No round in progress.")
            res = self._crash_resolve(db, pid, st, time.time(), True)
            return res
        out, err = self._run(go)
        if out:
            out["wallet"] = self.wallet_view(pid)
        return out, err

    # ----- Battles and Upgrader -----
    def battle(self, pid, bname):
        b = self.boxes().get(str(bname))
        if not b:
            return None, "That box is not available right now. Please refresh the page."
        def go(db):
            f = self._gf(db, pid, "battle")
            rolls = []
            for k in (0, 1):
                h = hashlib.sha256(("%s:%s:%d:%d" % (f["seed"], f["cs"], f["nonce"], k)).encode()).hexdigest()
                rolls.append(int(h[:8], 16) / 4294967296)
            ia, ib = self._pick(b["i"], rolls[0]), self._pick(b["i"], rolls[1])
            A, Bb = b["i"][ia], b["i"][ib]
            win = A[2] >= Bb[2]
            self._stake(db, pid, b["p"], "Battle: " + str(bname))
            items = []
            if win:
                now = time.time()
                for idx, it in ((ia, A), (ib, Bb)):
                    cur = db.execute("INSERT INTO items(pid,bname,name,icon,value_cents,rar,created) VALUES(?,?,?,?,?,?,?)", (pid, str(bname), it[0], it[1], it[2], self._tier(idx, len(b["i"])), now))
                    items.append(self._item_out(db.execute("SELECT * FROM items WHERE id=?", (cur.lastrowid,)).fetchone()))
            db.execute("INSERT INTO plays(pid,game,bet_cents,pay_cents,mult,ts) VALUES(?,?,?,?,?,?)", (pid, "battle", b["p"], (A[2] + Bb[2]) if win else 0, 0, time.time()))
            used, f2 = self._gf_roll(db, pid, "battle", {"box": str(bname), "a": ia, "b": ib})
            return {"ok": True, "win": win, "a": ia, "b": ib, "items": items, "fair": self._gf_out(f2)}
        out, err = self._run(go)
        if out:
            out["wallet"] = self.wallet_view(pid)
        return out, err

    UP_MU = (1.5, 2, 5, 10)

    def upgrade(self, pid, sid, mu):
        try:
            mu = float(mu)
        except (TypeError, ValueError):
            mu = 0
        if mu not in self.UP_MU:
            return None, "Choose a multiplier again."
        m = re.fullmatch(r"s(\d{1,12})", str(sid))
        if not m:
            return None, "That item was not found."
        chance = int(95 // mu)
        def go(db):
            r = db.execute("SELECT * FROM items WHERE id=? AND pid=?", (int(m.group(1)), pid)).fetchone()
            if not r or r["status"] != "held":
                raise GameErr("That item was not found.")
            if r["ship"]:
                raise GameErr("Cancel the shipment first to upgrade this item.")
            f = self._gf(db, pid, "upgrade")
            h = hashlib.sha256(("%s:%s:%d" % (f["seed"], f["cs"], f["nonce"])).encode()).hexdigest()
            roll = int(h[:8], 16) / 4294967296 * 100
            win = roll < chance
            db.execute("UPDATE items SET status=? WHERE id=?", ("upgraded" if win else "lost", r["id"]))
            item = None
            if win:
                v = int((Decimal(r["value_cents"]) * Decimal(repr(mu))).quantize(Decimal(1), rounding=ROUND_HALF_UP))
                rar = 4 if mu >= 10 else 3 if mu >= 5 else 2 if mu >= 2 else 1
                cur = db.execute("INSERT INTO items(pid,bname,name,icon,value_cents,rar,created) VALUES(?,?,?,?,?,?,?)", (pid, "Upgrader", "Upgrade prize", "up", v, rar, time.time()))
                item = self._item_out(db.execute("SELECT * FROM items WHERE id=?", (cur.lastrowid,)).fetchone())
            db.execute("INSERT INTO plays(pid,game,bet_cents,pay_cents,mult,ts) VALUES(?,?,?,?,?,?)", (pid, "upgrade", r["value_cents"], item and int(item["v"] * 100) or 0, mu, time.time()))
            used, f2 = self._gf_roll(db, pid, "upgrade", {"item": r["id"], "mu": mu, "chance": chance, "roll": roll})
            return {"ok": True, "win": win, "item": item, "chance": chance, "roll": roll, "fair": self._gf_out(f2), "lost": r["name"]}
        return self._run(go)

    def crash_cancel(self, pid):
        """Player left during the countdown: the bet goes back (only possible before take-off)."""
        def go(db):
            st = self._crash_round(db, pid)
            if not st:
                return {"done": True, "none": True}
            if time.time() >= st["t0"]:
                raise GameErr("The roadster already took off.")
            self._post(db, pid, "refund", st["bet"], "G", "Flying Roadster bet returned")
            db.execute("DELETE FROM rounds WHERE pid=? AND game='crash'", (pid,))
            return {"done": True, "refund": True}
        out, err = self._run(go)
        if out:
            out["wallet"] = self.wallet_view(pid)
        return out, err

    def crash_state(self, pid):
        def go(db):
            st = self._crash_round(db, pid)
            if not st:
                return {"active": False}
            now = time.time()
            res = self._crash_resolve(db, pid, st, now, False)
            if res:
                res["active"] = False
                return res
            return {"active": True, "t": now - st["t0"], "bet_cents": st["bet"], "auto": st["auto"]}
        out, err = self._run(go)
        if out and out.get("done"):
            out["wallet"] = self.wallet_view(pid)
        return out, err

    def request_deposit(self, pid, coin_id, amount, txid):
        db = self.wdb()
        try:
            st = self.settings(db)
            if not st["real_deposits"]:
                return None, "Real deposits are not open yet."
            coin = next((c for c in st["coins"] if c.get("id") == coin_id and c.get("enabled") and c.get("address")), None)
            if not coin:
                return None, "Please choose a payment method."
            cents = self.cents(amount)
            if cents is None or cents < int(float(st["min_deposit"]) * 100):
                return None, "The smallest deposit is $%g." % st["min_deposit"]
            tx = re.sub(r"\s+", "", str(txid))
            if not re.match(r"^[A-Za-z0-9_\-:.]{16,128}$", tx):
                return None, "Please paste the transaction hash (ID) from your wallet or exchange."
            tx = tx.lower()
            try:
                db.execute("BEGIN IMMEDIATE")
                db.execute("INSERT INTO deposits(pid,coin,network,claimed_cents,txid,created) VALUES(?,?,?,?,?,?)", (pid, coin["label"], coin.get("network", ""), cents, tx, time.time()))
                db.execute("COMMIT")
            except sqlite3.IntegrityError:
                db.execute("ROLLBACK")
                return None, "That transaction was already submitted."
            return True, None
        finally:
            db.close()

    def request_withdrawal(self, pid, coin_id, address, amount):
        db = self.wdb()
        try:
            st = self.settings(db)
            if not st["real_withdrawals"]:
                return None, "Real withdrawals are not open yet."
            coin = next((c for c in st["coins"] if c.get("id") == coin_id and c.get("enabled")), None)
            if not coin:
                return None, "Please choose a coin."
            addr = str(address).strip()
            rx = self.ADDR.get(coin.get("addr_type"))
            if rx and not rx.match(addr):
                return None, "That does not look like a valid %s address. Please check it." % coin["label"]
            if not rx and not re.match(r"^[A-Za-z0-9:_\-.]{10,120}$", addr):
                return None, "Please check the address."
            cents = self.cents(amount)
            if cents is None or cents < int(float(st["min_withdraw"]) * 100):
                return None, "The smallest withdrawal is $%g." % st["min_withdraw"]
            try:
                db.execute("BEGIN IMMEDIATE")
                cur = db.execute("INSERT INTO withdrawals(pid,coin,network,address,cents,created) VALUES(?,?,?,?,?,?)", (pid, coin["label"], coin.get("network", ""), addr, cents, time.time()))
                self._post(db, pid, "withdraw_hold", -cents, "W%d" % cur.lastrowid, "Withdrawal to %s" % coin["label"])
                db.execute("COMMIT")
            except ValueError:
                db.execute("ROLLBACK")
                return None, "You do not have enough balance."
            return True, None
        finally:
            db.close()

