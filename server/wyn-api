        self.signup_lim = Limiter(5, 3600)
        self.login_ip = Limiter(10, 900)
        self.login_id = Limiter(10, 900)
        self.name_lim = Limiter(60, 600)
        self.chat_lim = Limiter(90, 60)
        self.dep_lim = Limiter(10, 3600)
        self.wd_lim = Limiter(6, 3600)
        self.forgot_ip = Limiter(5, 3600)
        self.forgot_em = Limiter(3, 3600)
        self.reset_lim = Limiter(10, 900)
        self.chat_msg_lim = Limiter(20, 60)
        db = self.db()
        db.executescript("""
        CREATE TABLE IF NOT EXISTS players(
          id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, name_l TEXT NOT NULL UNIQUE,
          email TEXT NOT NULL UNIQUE, salt BLOB NOT NULL, hash BLOB NOT NULL, created REAL NOT NULL,
