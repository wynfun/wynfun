def mail_conf():
    c = read_json(MAIL_FILE, None)
    return c if isinstance(c, dict) and c.get("api_key") and c.get("from") else None

def send_mail(to, subject, text, html=None):
    """Sends one email through Resend. Never raises; returns (ok, message)."""
    c = mail_conf()
    if not c:
        return False, "email is not set up"
    try:
        req = urllib.request.Request(
            MAIL_URL,
            data=json.dumps(dict({"from": c["from"], "to": [to], "subject": subject, "text": text}, **({"html": html} if html else {}))).encode(),
            headers={"Authorization": "Bearer " + c["api_key"], "Content-Type": "application/json", "User-Agent": "wyn-api/1.0"},
            method="POST")
        with urllib.request.urlopen(req, timeout=12) as r:
            return True, "sent (%d)" % r.status
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("message", "")
        except Exception:
            msg = ""
        return False, "HTTP %d %s" % (e.code, msg[:200])
    except Exception as e:
        return False, str(e)[:200]

def send_async(to, subject, text, html=None):
    def run():
        ok, msg = send_mail(to, subject, text, html)
        if not ok:
            sys.stderr.write("mail to a player failed: %s\n" % msg)
    threading.Thread(target=run, daemon=True).start()

