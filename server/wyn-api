#!/usr/bin/env python3
"""wyn.fun server API (no extra packages needed).

  wyn-api serve <live|staging>        run the API (started by systemd)
  wyn-api setup <live|staging|both>   create / reset the admin login

Players: sign up / log in / saved game state (sqlite file per site).
Admin login = username + password + 6-digit code from an authenticator app.
Passwords are stored only as a salted scrypt hash. Nothing secret is in GitHub.
"""
import base64, getpass, hashlib, hmac, json, os, re, secrets, shutil, sqlite3, struct, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORTS = {"live": 8081, "staging": 8082}
BASE = os.environ.get("WYN_DATA_BASE", "/var/lib/wyn")
SESSION_IDLE = 12 * 3600          # sign out after 12 h of no use
SESSION_MAX = 7 * 24 * 3600       # and always after 7 days
COOKIE = "__Host-wyn_admin"
INSECURE = os.environ.get("WYN_INSECURE") == "1"   # tests only (no https)
LOCK = threading.Lock()


# ---------- small helpers ----------
def data_dir(env):
    return os.path.join(BASE, env)

def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default

def write_json(path, obj, mode=0o600):
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(obj, f)
    os.replace(tmp, path)
    os.chmod(path, mode)

def scrypt(password, salt):
    return hashlib.scrypt(password.encode("utf-8"), salt=salt, n=2 ** 14, r=8, p=1, dklen=32)

def totp(secret_b32, step):
    key = base64.b32decode(secret_b32)
    h = hmac.new(key, struct.pack(">Q", step), "sha1").digest()
    o = h[-1] & 15
    return "%06d" % ((struct.unpack(">I", h[o:o + 4])[0] & 0x7FFFFFFF) % 1000000)

def sha(s):
    return hashlib.sha256(s.encode()).hexdigest()


# ---------- login protection ----------
class Guard:
    """Slows down password guessing: per visitor and for the whole site."""
    def __init__(self):
        self.ip = {}
        self.all = []

    def blocked(self, ip):
        now = time.time()
        self.all = [t for t in self.all if now - t < 900]
        v = [t for t in self.ip.get(ip, []) if now - t < 900]
        self.ip[ip] = v
        return len(v) >= 5 or len(self.all) >= 25

    def fail(self, ip):
        now = time.time()
        self.ip.setdefault(ip, []).append(now)
        self.all.append(now)

    def ok(self, ip):
        self.ip.pop(ip, None)


# ---------- players ----------
PCOOKIE = "__Host-wyn_player"
PSESSION_IDLE = 30 * 24 * 3600
PSESSION_MAX = 90 * 24 * 3600
NAME_RE = re.compile(r"^[A-Za-z0-9_]{3,20}$")
EMAIL_RE = re.compile(r"^[^@\s]{1,64}@[^@\s]{1,190}\.[^@\s]{2,30}$")
RESERVED = {"admin", "administrator", "support", "wyn", "wynfun", "staff", "team", "moderator", "mod", "system", "root", "help", "official", "guest"}
STATE_KEYS = ("bal", "inv", "hist", "daily", "stats", "user", "set")
STATE_MAX = 400 * 1024


class Limiter:
    """n tries per window seconds for a key (in memory)."""
    def __init__(self, n, window):
        self.n, self.w, self.d = n, window, {}

    def hit(self, key):
        now = time.time()
        v = [t for t in self.d.get(key, []) if now - t < self.w]
        self.d[key] = v
        if len(v) >= self.n:
            return False
        v.append(now)
        return True

    def peek(self, key):
        now = time.time()
        return len([t for t in self.d.get(key, []) if now - t < self.w]) < self.n

    def clear(self, key):
        self.d.pop(key, None)


class Players:
    def __init__(self, folder):
        self.path = os.path.join(folder, "players.sqlite")
        self.signup_lim = Limiter(5, 3600)
        self.login_ip = Limiter(10, 900)
        self.login_id = Limiter(10, 900)
        self.name_lim = Limiter(60, 600)
        db = self.db()
        db.executescript("""
        CREATE TABLE IF NOT EXISTS players(
          id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, name_l TEXT NOT NULL UNIQUE,
          email TEXT NOT NULL UNIQUE, salt BLOB NOT NULL, hash BLOB NOT NULL, created REAL NOT NULL,
          last_login REAL, state TEXT, ver INTEGER NOT NULL DEFAULT 0, upd REAL, banned INTEGER NOT NULL DEFAULT 0);
        CREATE TABLE IF NOT EXISTS psessions(h TEXT PRIMARY KEY, pid INTEGER NOT NULL, idle REAL NOT NULL, mx REAL NOT NULL);
        CREATE INDEX IF NOT EXISTS ps_pid ON psessions(pid);
        """)
        db.commit()
        db.close()
        try:
            os.chmod(self.path, 0o600)
        except Exception:
            pass

    def db(self):
        c = sqlite3.connect(self.path, timeout=10)
        c.row_factory = sqlite3.Row
        c.execute("PRAGMA journal_mode=WAL")
        return c

    def signup(self, name, email, password, state):
        name, email = name.strip(), email.strip().lower()
        if not NAME_RE.match(name):
            return None, "Username needs 3 to 20 letters, numbers or underscores."
        if name.lower() in RESERVED:
            return None, "That username is not available. Try another one."
        if not EMAIL_RE.match(email):
            return None, "Please enter a valid email address."
        if len(password) < 8:
            return None, "Your password needs at least 8 characters."
        if len(password) > 200:
            return None, "That password is too long."
        salt = secrets.token_bytes(16)
        h = scrypt(password, salt)
        st = clean_state(state)
        now = time.time()
        db = self.db()
        try:
            if db.execute("SELECT 1 FROM players WHERE email=?", (email,)).fetchone():
                return None, "That email already has an account. Try logging in."
            if db.execute("SELECT 1 FROM players WHERE name_l=?", (name.lower(),)).fetchone():
                return None, "That username is taken. Try another one."
            cur = db.execute("INSERT INTO players(name,name_l,email,salt,hash,created,last_login,state,ver,upd) VALUES(?,?,?,?,?,?,?,?,?,?)",
                             (name, name.lower(), email, salt, h, now, now, json.dumps(st) if st else None, 1 if st else 0, now))
            db.commit()
            return cur.lastrowid, None
        except sqlite3.IntegrityError:
            return None, "That username or email is already used."
        finally:
            db.close()

    def check_login(self, ident, password):
        ident = ident.strip().lower()
        db = self.db()
        try:
            r = db.execute("SELECT * FROM players WHERE email=? OR name_l=?", (ident, ident)).fetchone()
            salt = bytes(r["salt"]) if r else b"\0" * 16
            h = scrypt(password, salt)
            if r and not r["banned"] and hmac.compare_digest(h, bytes(r["hash"])):
                db.execute("UPDATE players SET last_login=? WHERE id=?", (time.time(), r["id"]))
                db.commit()
                return r["id"]
            return None
        finally:
            db.close()

    def new_session(self, pid):
        tok = secrets.token_urlsafe(32)
        now = time.time()
        db = self.db()
        db.execute("DELETE FROM psessions WHERE idle<? OR mx<?", (now, now))
        db.execute("INSERT INTO psessions(h,pid,idle,mx) VALUES(?,?,?,?)", (sha(tok), pid, now + PSESSION_IDLE, now + PSESSION_MAX))
        db.commit()
        db.close()
        return tok

    def session_player(self, tok):
        if not tok:
            return None
        now = time.time()
        db = self.db()
        try:
            s = db.execute("SELECT * FROM psessions WHERE h=?", (sha(tok),)).fetchone()
            if not s or s["idle"] < now or s["mx"] < now:
                return None
            p = db.execute("SELECT * FROM players WHERE id=? AND banned=0", (s["pid"],)).fetchone()
            if not p:
                return None
            db.execute("UPDATE psessions SET idle=? WHERE h=?", (min(now + PSESSION_IDLE, s["mx"]), s["h"]))
            db.commit()
            return dict(p)
        finally:
            db.close()

    def end_session(self, tok):
        db = self.db()
        db.execute("DELETE FROM psessions WHERE h=?", (sha(tok or ""),))
        db.commit()
        db.close()

    def name_free(self, name):
        n = name.strip().lower()
        if not NAME_RE.match(name.strip()) or n in RESERVED:
            return False
        db = self.db()
        try:
            return db.execute("SELECT 1 FROM players WHERE name_l=?", (n,)).fetchone() is None
        finally:
            db.close()

    def save_state(self, pid, state, ver):
        st = clean_state(state)
        if not st:
            return False, None, None
        db = self.db()
        try:
            cur = db.execute("UPDATE players SET state=?, ver=ver+1, upd=? WHERE id=? AND ver=?", (json.dumps(st), time.time(), pid, ver))
            db.commit()
            if cur.rowcount == 1:
                return True, ver + 1, None
            r = db.execute("SELECT state, ver FROM players WHERE id=?", (pid,)).fetchone()
            return False, r["ver"], (json.loads(r["state"]) if r["state"] else None)
        finally:
            db.close()

    def public(self, p):
        return {"name": p["name"], "email": p["email"], "created": p["created"],
                "state": json.loads(p["state"]) if p["state"] else None, "ver": p["ver"]}

    def listing(self):
        db = self.db()
        try:
            out = []
            for r in db.execute("SELECT * FROM players ORDER BY created DESC LIMIT 5000"):
                st = json.loads(r["state"]) if r["state"] else {}
                stats = st.get("stats") or {}
                out.append({"id": r["id"], "name": r["name"], "email": r["email"], "created": r["created"], "last_login": r["last_login"],
                            "bal": st.get("bal"), "opens": stats.get("opens"), "spent": stats.get("spent"), "won": stats.get("won"), "banned": bool(r["banned"]),
                            "name_": r["name"], "state": st or None})
            return out
        finally:
            db.close()


def clean_state(st):
    """Keep only the game fields we know, and refuse silly sizes or values."""
    if not isinstance(st, dict):
        return None
    out = {k: st[k] for k in STATE_KEYS if k in st}
    bal = out.get("bal")
    if not isinstance(bal, (int, float)) or isinstance(bal, bool) or bal != bal or bal < 0 or bal > 1e9:
        return None
    if len(json.dumps(out)) > STATE_MAX:
        return None
    if isinstance(out.get("user"), dict):
        out["user"] = {k: v for k, v in out["user"].items() if k not in ("email",)}
    return out


class App:
    def __init__(self, env):
        self.env = env
        self.dir = data_dir(env)
        os.makedirs(self.dir, exist_ok=True)
        self.admin_file = os.path.join(self.dir, "admin.json")
        self.sess_file = os.path.join(self.dir, "sessions.json")
        self.guard = Guard()
        self.players = Players(self.dir)

    # sessions are stored hashed, so a leaked file cannot be used to sign in
    def sessions(self):
        now = time.time()
        d = read_json(self.sess_file, {})
        d = {k: v for k, v in d.items() if v["idle"] > now and v["max"] > now}
        return d

    def new_session(self):
        tok = secrets.token_urlsafe(32)
        now = time.time()
        with LOCK:
            d = self.sessions()
            d[sha(tok)] = {"idle": now + SESSION_IDLE, "max": now + SESSION_MAX}
            write_json(self.sess_file, d)
        return tok

    def check_session(self, tok):
        if not tok:
            return False
        with LOCK:
            d = self.sessions()
            s = d.get(sha(tok))
            if not s:
                return False
            s["idle"] = min(time.time() + SESSION_IDLE, s["max"])
            write_json(self.sess_file, d)
            return True

    def end_session(self, tok):
        with LOCK:
            d = self.sessions()
            d.pop(sha(tok or ""), None)
            write_json(self.sess_file, d)

    def login(self, user, password, code):
        a = read_json(self.admin_file, None)
        # always do the same work, so timing does not reveal what was wrong
        salt = bytes.fromhex(a["salt"]) if a else b"\0" * 16
        h = scrypt(password, salt)
        good_pw = a is not None and hmac.compare_digest(h.hex(), a["hash"])
        good_user = a is not None and hmac.compare_digest(user.strip().lower().encode(), a["user"].encode())
        good_code = False
        if a:
            now_step = int(time.time() // 30)
            code = "".join(ch for ch in code if ch.isdigit())
            with LOCK:
                a = read_json(self.admin_file, a)
                for st in (now_step - 1, now_step, now_step + 1):
                    if st > a.get("last", 0) and hmac.compare_digest(totp(a["totp"], st), code):
                        good_code = True
                        if good_pw and good_user:
                            a["last"] = st          # a code works only once
                            write_json(self.admin_file, a)
                        break
        return good_pw and good_user and good_code


APPS = {}


class H(BaseHTTPRequestHandler):
    server_version = "wyn"
    sys_version = ""
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *a):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % a))

    def ip(self):
        xf = self.headers.get("X-Forwarded-For", "")
        return (xf.split(",")[0].strip() or self.client_address[0])

    def send(self, code, obj, cookie=None):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        if cookie:
            self.send_header("Set-Cookie", cookie)
        self.end_headers()
        self.wfile.write(body)

    def cookie_val(self):
        for part in self.headers.get("Cookie", "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == COOKIE:
                return v
        return ""

    def set_cookie(self, val, max_age):
        c = "%s=%s; Path=/; Max-Age=%d; HttpOnly; SameSite=Strict" % (COOKIE, val, max_age)
        return c if INSECURE else c + "; Secure"

    def pcookie_val(self):
        for part in self.headers.get("Cookie", "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == PCOOKIE:
                return v
        return ""

    def set_pcookie(self, val, max_age):
        c = "%s=%s; Path=/; Max-Age=%d; HttpOnly; SameSite=Lax" % (PCOOKIE, val, max_age)
        return c if INSECURE else c + "; Secure"

    def admin_ok(self):
        return self.server.app.check_session(self.cookie_val())

    def same_origin(self):
        o = self.headers.get("Origin")
        if not o:
            return True
        host = self.headers.get("Host", "")
        return o.split("://", 1)[-1] == host

    def do_GET(self):
        app = self.server.app
        if self.path == "/api/admin/me":
            return self.send(200, {"ok": app.check_session(self.cookie_val())})
        if self.path == "/api/health":
            return self.send(200, {"ok": True, "env": app.env})
        if self.path == "/api/me":
            p = app.players.session_player(self.pcookie_val())
            return self.send(200, {"api": True, "user": app.players.public(p) if p else None})
        if self.path.startswith("/api/name?"):
            if not app.players.name_lim.hit(self.ip()):
                return self.send(429, {"error": "slow down"})
            from urllib.parse import urlparse, parse_qs
            n = (parse_qs(urlparse(self.path).query).get("n") or [""])[0][:40]
            return self.send(200, {"free": app.players.name_free(n)})
        if self.path == "/api/admin/players":
            if not self.admin_ok():
                return self.send(401, {"error": "sign in"})
            return self.send(200, {"players": app.players.listing()})
        self.send(404, {"error": "not found"})

    def do_POST(self):
        app = self.server.app
        if not self.same_origin() or "json" not in self.headers.get("Content-Type", ""):
            return self.send(403, {"error": "blocked"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(min(n, 450 * 1024)) or b"{}")
        except Exception:
            return self.send(400, {"error": "bad request"})
        if self.path == "/api/admin/login":
            ip = self.ip()
            if app.guard.blocked(ip):
                return self.send(429, {"error": "Too many tries. Please wait 15 minutes."})
            ok = app.login(str(body.get("user", ""))[:100], str(body.get("password", ""))[:200], str(body.get("code", ""))[:20])
            if not ok:
                app.guard.fail(ip)
                time.sleep(0.6)
                return self.send(401, {"error": "Those details are not right. Check the username, password and the 6-digit code."})
            app.guard.ok(ip)
            tok = app.new_session()
            return self.send(200, {"ok": True}, self.set_cookie(tok, SESSION_MAX))
        if self.path == "/api/signup":
            ip = self.ip()
            if not app.players.signup_lim.hit(ip):
                return self.send(429, {"error": "Too many new accounts from this connection. Please try again later."})
            pid, err = app.players.signup(str(body.get("name", ""))[:40], str(body.get("email", ""))[:260], str(body.get("password", ""))[:300], body.get("state"))
            if err:
                return self.send(400, {"error": err})
            tok = app.players.new_session(pid)
            p = app.players.session_player(tok)
            return self.send(200, {"ok": True, "user": app.players.public(p)}, self.set_pcookie(tok, PSESSION_MAX))
        if self.path == "/api/login":
            ip = self.ip()
            ident = str(body.get("id", ""))[:260].strip().lower()
            if not app.players.login_ip.peek(ip) or not app.players.login_id.peek(ident):
                return self.send(429, {"error": "Too many tries. Please wait 15 minutes."})
            pid = app.players.check_login(ident, str(body.get("password", ""))[:300])
            if not pid:
                app.players.login_ip.hit(ip)
                app.players.login_id.hit(ident)
                time.sleep(0.5)
                return self.send(401, {"error": "That email, username or password is not right."})
            app.players.login_id.clear(ident)
            tok = app.players.new_session(pid)
            p = app.players.session_player(tok)
            return self.send(200, {"ok": True, "user": app.players.public(p)}, self.set_pcookie(tok, PSESSION_MAX))
        if self.path == "/api/logout":
            app.players.end_session(self.pcookie_val())
            return self.send(200, {"ok": True}, self.set_pcookie("", 0))
        if self.path == "/api/state":
            p = app.players.session_player(self.pcookie_val())
            if not p:
                return self.send(401, {"error": "sign in"})
            try:
                ver = int(body.get("ver"))
            except Exception:
                return self.send(400, {"error": "bad request"})
            ok, nver, other = app.players.save_state(p["id"], body.get("state"), ver)
            if ok:
                return self.send(200, {"ok": True, "ver": nver})
            if nver is None:
                return self.send(400, {"error": "bad state"})
            return self.send(409, {"error": "newer", "ver": nver, "state": other})
        if self.path == "/api/admin/logout":
            app.end_session(self.cookie_val())
            return self.send(200, {"ok": True}, self.set_cookie("", 0))
        self.send(404, {"error": "not found"})


def serve(env):
    port = int(os.environ.get("WYN_PORT") or PORTS[env])
    srv = ThreadingHTTPServer(("127.0.0.1", port), H)
    srv.app = App(env)
    print("wyn-api %s listening on 127.0.0.1:%d" % (env, port), flush=True)
    srv.serve_forever()


# ---------- one-time admin setup (run by you on the server) ----------
def setup(which):
    envs = ["live", "staging"] if which == "both" else [which]
    print("\nCreate the admin login for: %s\n" % " + ".join(envs))
    user = (input("Admin username (e.g. admin): ").strip().lower() or "admin")
    while True:
        p1 = getpass.getpass("Choose a password (min 12 characters): ")
        p2 = getpass.getpass("Type it again: ")
        if p1 == p2 and len(p1) >= 12:
            break
        print("They did not match or were too short. Try again.")
    secret = base64.b32encode(secrets.token_bytes(20)).decode()
    uri = "otpauth://totp/wyn.fun%%20admin:%s?secret=%s&issuer=wyn.fun" % (user, secret)
    print("\nOn your PHONE, open an authenticator app (Google Authenticator, Microsoft Authenticator or Authy),")
    print("tap  +  then  Scan a QR code, and scan this:\n")
    if shutil.which("qrencode"):
        subprocess.call(["qrencode", "-t", "ANSIUTF8", "-m", "2", uri])
    print("\nCannot scan? Add it by typing this key instead:  %s\n" % " ".join(secret[i:i + 4] for i in range(0, len(secret), 4)))
    while True:
        c = input("Type the 6-digit code your app shows now: ").strip().replace(" ", "")
        if any(hmac.compare_digest(totp(secret, int(time.time() // 30) + d), c) for d in (-1, 0, 1)):
            break
        print("That code is not right (they change every 30 seconds). Try the new one.")
    salt = secrets.token_bytes(16)
    for env in envs:
        d = data_dir(env)
        os.makedirs(d, exist_ok=True)
        write_json(os.path.join(d, "admin.json"), {"user": user, "salt": salt.hex(), "hash": scrypt(p1, salt).hex(), "totp": secret, "last": int(time.time() // 30)})
        write_json(os.path.join(d, "sessions.json"), {})        # signs out every old session
        try:
            import pwd
            u = pwd.getpwnam("wynapi")
            for f in ("admin.json", "sessions.json"):
                os.chown(os.path.join(d, f), u.pw_uid, u.pw_gid)
            os.chown(d, u.pw_uid, u.pw_gid)
        except Exception:
            pass
    print("\nDone. Admin login saved for: %s. Open https://wyn.fun/#admin to try it.\n" % ", ".join(envs))


if __name__ == "__main__":
    a = sys.argv[1:]
    if len(a) == 2 and a[0] == "serve" and a[1] in PORTS:
        serve(a[1])
    elif len(a) == 2 and a[0] == "setup" and a[1] in ("live", "staging", "both"):
        setup(a[1])
    else:
        print(__doc__)
        sys.exit(2)
