class H(BaseHTTPRequestHandler):
    server_version = "wyn"
    sys_version = ""
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *a):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % a))

    def ip(self):
        xf = self.headers.get("X-Forwarded-For", "")
        return (xf.split(",")[0].strip() or self.client_address[0])

    def send(self, code, obj, cookie=None):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        if cookie:
            self.send_header("Set-Cookie", cookie)
        self.end_headers()
        self.wfile.write(body)

    def cookie_val(self):
        for part in self.headers.get("Cookie", "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == COOKIE:
                return v
        return ""

    def set_cookie(self, val, max_age):
        c = "%s=%s; Path=/; Max-Age=%d; HttpOnly; SameSite=Strict" % (COOKIE, val, max_age)
        return c if INSECURE else c + "; Secure"

    def pcookie_val(self):
        for part in self.headers.get("Cookie", "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == PCOOKIE:
                return v
        return ""

    def set_pcookie(self, val, max_age):
        c = "%s=%s; Path=/; Max-Age=%d; HttpOnly; SameSite=Lax" % (PCOOKIE, val, max_age)
        return c if INSECURE else c + "; Secure"

    def admin_ok(self):
        return self.server.app.check_session(self.cookie_val())

    def same_origin(self):
        o = self.headers.get("Origin")
        if not o:
            return True
        host = self.headers.get("Host", "")
        return o.split("://", 1)[-1] == host

    def do_GET(self):
        app = self.server.app
        if self.path == "/api/admin/me":
            return self.send(200, {"ok": app.check_session(self.cookie_val())})
        if self.path == "/api/health":
            return self.send(200, {"ok": True, "env": app.env})
        if self.path == "/api/me":
            p = app.players.session_player(self.pcookie_val())
            return self.send(200, {"api": True, "mail": bool(mail_conf()), "user": app.players.public(p) if p else None})
        if self.path.startswith("/api/name?"):
            if not app.players.name_lim.hit(self.ip()):
                return self.send(429, {"error": "slow down"})
            from urllib.parse import urlparse, parse_qs
            n = (parse_qs(urlparse(self.path).query).get("n") or [""])[0][:40]
            return self.send(200, {"free": app.players.name_free(n)})
        if self.path == "/api/wallet":
            p = app.players.session_player(self.pcookie_val())
            if not p:
                return self.send(401, {"error": "sign in"})
            return self.send(200, app.players.wallet_view(p["id"]))
        if self.path == "/api/admin/wallet":
            if not self.admin_ok():
                return self.send(401, {"error": "sign in"})
            return self.send(200, app.players.admin_wallet())
        if self.path == "/api/admin/players":
            if not self.admin_ok():
                return self.send(401, {"error": "sign in"})
            return self.send(200, {"players": app.players.listing()})
        self.send(404, {"error": "not found"})

    def do_POST(self):
        app = self.server.app
        if not self.same_origin() or "json" not in self.headers.get("Content-Type", ""):
            return self.send(403, {"error": "blocked"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(min(n, 450 * 1024)) or b"{}")
        except Exception:
            return self.send(400, {"error": "bad request"})
        if self.path == "/api/admin/login":
            ip = self.ip()
            if app.guard.blocked(ip):
                return self.send(429, {"error": "Too many tries. Please wait 15 minutes."})
            ok = app.login(str(body.get("user", ""))[:100], str(body.get("password", ""))[:200], str(body.get("code", ""))[:20])
            if not ok:
                app.guard.fail(ip)
                time.sleep(0.6)
                return self.send(401, {"error": "Those details are not right. Check the username, password and the 6-digit code."})
            app.guard.ok(ip)
            tok = app.new_session()
            return self.send(200, {"ok": True}, self.set_cookie(tok, SESSION_MAX))
        if self.path == "/api/signup":
            ip = self.ip()
            if not app.players.signup_lim.hit(ip):
                return self.send(429, {"error": "Too many new accounts from this connection. Please try again later."})
            pid, err = app.players.signup(str(body.get("name", ""))[:40], str(body.get("email", ""))[:260], str(body.get("password", ""))[:300], body.get("state"))
            if err:
                return self.send(400, {"error": err})
            tok = app.players.new_session(pid)
            p = app.players.session_player(tok)
            if mail_conf():
                txt, html = welcome_mail(p["name"], base_url(app.env))
                send_async(p["email"], "Welcome to wyn.fun, %s" % p["name"], txt, html)
            return self.send(200, {"ok": True, "user": app.players.public(p)}, self.set_pcookie(tok, PSESSION_MAX))
        if self.path == "/api/login":
            ip = self.ip()
            ident = str(body.get("id", ""))[:260].strip().lower()
            if not app.players.login_ip.peek(ip) or not app.players.login_id.peek(ident):
                return self.send(429, {"error": "Too many tries. Please wait 15 minutes."})
            pid = app.players.check_login(ident, str(body.get("password", ""))[:300])
            if not pid:
                app.players.login_ip.hit(ip)
                app.players.login_id.hit(ident)
                time.sleep(0.5)
                return self.send(401, {"error": "That email, username or password is not right."})
            app.players.login_id.clear(ident)
            tok = app.players.new_session(pid)
            p = app.players.session_player(tok)
            return self.send(200, {"ok": True, "user": app.players.public(p)}, self.set_pcookie(tok, PSESSION_MAX))
        if self.path == "/api/forgot":
            email = str(body.get("email", ""))[:260].strip().lower()
            ip = self.ip()
            if not mail_conf():
                return self.send(200, {"ok": True, "mail": False})
            if not (app.players.forgot_ip.hit(ip) and app.players.forgot_em.hit(email)):
                return self.send(429, {"error": "Too many requests. Please try again later."})
            r = app.players.make_reset(email) if EMAIL_RE.match(email) else None
            if r:
                link = "%s/?reset=%s" % (base_url(app.env), r[1])
                txt, html = reset_mail(r[0], link)
                send_async(email, "Reset your wyn.fun password", txt, html)
            return self.send(200, {"ok": True, "mail": True})
        if self.path == "/api/reset":
            if not app.players.reset_lim.hit(self.ip()):
                return self.send(429, {"error": "Too many tries. Please wait a few minutes."})
            err = app.players.use_reset(str(body.get("token", ""))[:100], str(body.get("password", ""))[:300])
            if err:
                return self.send(400, {"error": err})
            return self.send(200, {"ok": True})
        if self.path == "/api/logout":
            app.players.end_session(self.pcookie_val())
            return self.send(200, {"ok": True}, self.set_pcookie("", 0))
        if self.path == "/api/state":
            p = app.players.session_player(self.pcookie_val())
            if not p:
                return self.send(401, {"error": "sign in"})
            try:
                ver = int(body.get("ver"))
            except Exception:
                return self.send(400, {"error": "bad request"})
            ok, nver, other = app.players.save_state(p["id"], body.get("state"), ver)
            if ok:
                return self.send(200, {"ok": True, "ver": nver})
            if nver is None:
                return self.send(400, {"error": "bad state"})
            return self.send(409, {"error": "newer", "ver": nver, "state": other})
        if self.path == "/api/chat/sync":
            p = app.players.session_player(self.pcookie_val())
            if not p:
                return self.send(401, {"error": "sign in"})
            if not app.players.chat_lim.hit(p["id"]):
                return self.send(429, {"error": "slow down"})
            try:
                seq = int(body.get("seq") or 0)
            except Exception:
                seq = 0
            out = app.players.chat_player_sync(p["id"], seq, body.get("add"), body.get("mode"), bool(body.get("read")))
            return self.send(429 if out.get("error") else 200, out)
        if self.path == "/api/admin/chat/sync":
            if not self.admin_ok():
                return self.send(401, {"error": "sign in"})
            try:
                since = int(body.get("since") or 0)
            except Exception:
                since = 0
            return self.send(200, app.players.chat_admin_sync(since, body.get("add"), body.get("modes")))
        if self.path in ("/api/wallet/deposit", "/api/wallet/withdraw"):
            p = app.players.session_player(self.pcookie_val())
            if not p:
                return self.send(401, {"error": "sign in"})
            dep = self.path.endswith("deposit")
            if not (app.players.dep_lim if dep else app.players.wd_lim).hit(p["id"]):
                return self.send(429, {"error": "Too many requests. Please try again later."})
            if dep:
                ok, err = app.players.request_deposit(p["id"], str(body.get("coin", ""))[:40], body.get("amount"), body.get("txid", ""))
            else:
                ok, err = app.players.request_withdrawal(p["id"], str(body.get("coin", ""))[:40], body.get("address", ""), body.get("amount"))
            if err:
                return self.send(400, {"error": err})
            return self.send(200, {"ok": True, "wallet": app.players.wallet_view(p["id"])})
        if self.path.startswith("/api/admin/wallet/"):
            if not self.admin_ok():
                return self.send(401, {"error": "sign in"})
            who = "admin"
            act = self.path.rsplit("/", 1)[1]
            note = str(body.get("note", ""))[:300]
            if act == "deposit":
                r, err = app.players.admin_deposit(int(body.get("id") or 0), body.get("action"), body.get("amount"), note, who)
                if r and mail_conf():
                    if body.get("action") == "approve":
                        send_async(r["email"], "Your deposit was added", *wallet_mail(r["name"], "Deposit added", "Your deposit of $%.2f was confirmed and added to your wallet." % (r["cents"] / 100)))
                    else:
                        send_async(r["email"], "About your deposit", *wallet_mail(r["name"], "Deposit not confirmed", "We could not confirm your deposit. %s If you think this is a mistake, please contact support in the chat." % esc_html(note)))
            elif act == "withdrawal":
                r, err = app.players.admin_withdrawal(int(body.get("id") or 0), body.get("action"), body.get("txid", ""), note, who)
                if r and mail_conf():
                    if body.get("action") == "paid":
                        send_async(r["email"], "Your withdrawal was sent", *wallet_mail(r["name"], "Withdrawal sent", "Your withdrawal of $%.2f in %s was sent." % (r["cents"] / 100, esc_html(r["coin"]))))
                    else:
                        send_async(r["email"], "About your withdrawal", *wallet_mail(r["name"], "Withdrawal returned", "Your withdrawal could not be sent and $%.2f was returned to your wallet. %s" % (r["cents"] / 100, esc_html(note))))
            elif act == "adjust":
                r, err = app.players.admin_adjust(str(body.get("email", "")), body.get("amount"), note, who)
            elif act == "settings":
                r, err = app.players.admin_settings(body, who)
            else:
                return self.send(404, {"error": "not found"})
            if err:
                return self.send(400, {"error": err})
            return self.send(200, {"ok": True, "wallet": app.players.admin_wallet()})
        if self.path == "/api/admin/logout":
            app.end_session(self.cookie_val())
            return self.send(200, {"ok": True}, self.set_cookie("", 0))
        self.send(404, {"error": "not found"})


def serve(env):
    port = int(os.environ.get("WYN_PORT") or PORTS[env])
    srv = ThreadingHTTPServer(("127.0.0.1", port), H)
    srv.app = App(env)
    print("wyn-api %s listening on 127.0.0.1:%d" % (env, port), flush=True)
    srv.serve_forever()


# ---------- one-time admin setup (run by you on the server) ----------
def setup(which):
    envs = ["live", "staging"] if which == "both" else [which]
    print("\nCreate the admin login for: %s\n" % " + ".join(envs))
    user = (input("Admin username (e.g. admin): ").strip().lower() or "admin")
    while True:
        p1 = getpass.getpass("Choose a password (min 12 characters): ")
        p2 = getpass.getpass("Type it again: ")
        if p1 == p2 and len(p1) >= 12:
            break
        print("They did not match or were too short. Try again.")
    secret = base64.b32encode(secrets.token_bytes(20)).decode()
    uri = "otpauth://totp/wyn.fun%%20admin:%s?secret=%s&issuer=wyn.fun" % (user, secret)
    print("\nOn your PHONE, open an authenticator app (Google Authenticator, Microsoft Authenticator or Authy),")
    print("tap  +  then  Scan a QR code, and scan this:\n")
    if shutil.which("qrencode"):
        subprocess.call(["qrencode", "-t", "ANSIUTF8", "-m", "2", uri])
    print("\nCannot scan? Add it by typing this key instead:  %s\n" % " ".join(secret[i:i + 4] for i in range(0, len(secret), 4)))
    while True:
        c = input("Type the 6-digit code your app shows now: ").strip().replace(" ", "")
        if any(hmac.compare_digest(totp(secret, int(time.time() // 30) + d), c) for d in (-1, 0, 1)):
            break
        print("That code is not right (they change every 30 seconds). Try the new one.")
    salt = secrets.token_bytes(16)
    for env in envs:
        d = data_dir(env)
        os.makedirs(d, exist_ok=True)
        write_json(os.path.join(d, "admin.json"), {"user": user, "salt": salt.hex(), "hash": scrypt(p1, salt).hex(), "totp": secret, "last": int(time.time() // 30)})
        write_json(os.path.join(d, "sessions.json"), {})        # signs out every old session
        try:
            import pwd
            u = pwd.getpwnam("wynapi")
            for f in ("admin.json", "sessions.json"):
                os.chown(os.path.join(d, f), u.pw_uid, u.pw_gid)
            os.chown(d, u.pw_uid, u.pw_gid)
        except Exception:
            pass
    print("\nDone. Admin login saved for: %s. Open https://wyn.fun/#admin to try it.\n" % ", ".join(envs))


def mail_setup():
    print("\nEmail setup (uses the free Resend service).\n")
    key = getpass.getpass("Paste your Resend API key (nothing shows while you paste): ").strip()
    frm = input("Send emails from [wyn.fun <noreply@wyn.fun>]: ").strip() or "wyn.fun <noreply@wyn.fun>"
    os.makedirs(os.path.dirname(MAIL_FILE), exist_ok=True)
    conf = {"api_key": key, "from": frm}
    write_json(MAIL_FILE, conf, 0o640)
    try:
        import grp
        os.chown(MAIL_FILE, 0, grp.getgrnam("wynapi").gr_gid)
    except Exception:
        pass
    to = input("Send a test email to which address (leave empty to skip): ").strip()
    if to:
        ok, msg = send_mail(to, "wyn.fun test email", "If you can read this, wyn.fun can send emails.", email_html("It works!", ["If you can read this, wyn.fun can send emails."], ("Open wyn.fun", base_url("live")), hero=True))
        print("\nTest email:", "SENT. Check your inbox (and spam)." if ok else "FAILED: " + msg)
        if not ok:
            print("Tip: Resend only sends from a domain you verified. Check the DNS records in Resend.")
    print("\nDone. Password reset and welcome emails are now switched on.\n")


if __name__ == "__main__":
    a = sys.argv[1:]
    if len(a) == 2 and a[0] == "serve" and a[1] in PORTS:
        serve(a[1])
    elif len(a) == 2 and a[0] == "setup" and a[1] in ("live", "staging", "both"):
        setup(a[1])
    elif len(a) == 1 and a[0] == "mail-setup":
        mail_setup()
    else:
        print(__doc__)
        sys.exit(2)
