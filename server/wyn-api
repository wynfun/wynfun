    def admin_settings(self, data, who):
        coins = []
        for c in (data.get("coins") or [])[:20]:
            if not isinstance(c, dict):
                continue
            cid = re.sub(r"[^a-z0-9_\-]", "", str(c.get("id", "")).lower())[:30]
            addr = str(c.get("address", "")).strip()[:120]
            at = c.get("addr_type") if c.get("addr_type") in ("btc", "evm", "tron", "sol", "other") else "other"
            rx = self.ADDR.get(at)
            if not cid or not str(c.get("label", "")).strip():
                return None, "Every coin needs a short id and a name."
            if addr and rx and not rx.match(addr):
                return None, "The address for %s does not look right for its type." % c.get("label")
            coins.append({"id": cid, "label": str(c["label"]).strip()[:30], "network": str(c.get("network", "")).strip()[:30], "address": addr, "addr_type": at, "enabled": bool(c.get("enabled"))})
        vals = {"real_deposits": 1 if data.get("real_deposits") else 0, "real_withdrawals": 1 if data.get("real_withdrawals") else 0, "coins": coins}
        for k in ("min_deposit", "min_withdraw"):
            try:
                vals[k] = max(1, min(100000, float(data.get(k))))
            except Exception:
                return None, "Minimums must be numbers."
        db = self.wdb()
        try:
            db.execute("BEGIN IMMEDIATE")
            old = self.settings(db)
            for k, v in vals.items():
                db.execute("INSERT INTO settings(k,v) VALUES(?,?) ON CONFLICT(k) DO UPDATE SET v=excluded.v", (k, json.dumps(v)))
            self.audit(db, who, "settings", {"changed_addresses": [c["id"] for c in coins if next((o for o in old["coins"] if o.get("id") == c["id"] and o.get("address") == c["address"]), None) is None],
                                              "real_deposits": vals["real_deposits"], "real_withdrawals": vals["real_withdrawals"]})
            db.execute("COMMIT")
            return True, None
        finally:
            db.close()

    def public(self, p):
        return {"name": p["name"], "email": p["email"], "created": p["created"],
                "state": json.loads(p["state"]) if p["state"] else None, "ver": p["ver"]}

    def listing(self):
        db = self.db()
        try:
            out = []
            for r in db.execute("SELECT * FROM players ORDER BY created DESC LIMIT 5000"):
                st = json.loads(r["state"]) if r["state"] else {}
                stats = st.get("stats") or {}
                out.append({"id": r["id"], "name": r["name"], "email": r["email"], "created": r["created"], "last_login": r["last_login"],
                            "bal": st.get("bal"), "opens": stats.get("opens"), "spent": stats.get("spent"), "won": stats.get("won"), "banned": bool(r["banned"]),
                            "name_": r["name"], "state": st or None})
            return out
        finally:
            db.close()


def clean_state(st):
    """Keep only the game fields we know, and refuse silly sizes or values."""
    if not isinstance(st, dict):
        return None
    out = {k: st[k] for k in STATE_KEYS if k in st}
    bal = out.get("bal")
    if not isinstance(bal, (int, float)) or isinstance(bal, bool) or bal != bal or bal < 0 or bal > 1e9:
        return None
    if len(json.dumps(out)) > STATE_MAX:
        return None
    if isinstance(out.get("user"), dict):
        out["user"] = {k: v for k, v in out["user"].items() if k not in ("email",)}
    return out


class App:
    def __init__(self, env):
        self.env = env
        self.dir = data_dir(env)
        os.makedirs(self.dir, exist_ok=True)
        self.admin_file = os.path.join(self.dir, "admin.json")
        self.sess_file = os.path.join(self.dir, "sessions.json")
        self.guard = Guard()
        self.players = Players(self.dir, env)

    # sessions are stored hashed, so a leaked file cannot be used to sign in
    def sessions(self):
        now = time.time()
        d = read_json(self.sess_file, {})
        d = {k: v for k, v in d.items() if v["idle"] > now and v["max"] > now}
        return d

    def new_session(self):
        tok = secrets.token_urlsafe(32)
        now = time.time()
        with LOCK:
            d = self.sessions()
            d[sha(tok)] = {"idle": now + SESSION_IDLE, "max": now + SESSION_MAX}
            write_json(self.sess_file, d)
        return tok

    def check_session(self, tok):
        if not tok:
            return False
        with LOCK:
            d = self.sessions()
            s = d.get(sha(tok))
            if not s:
                return False
            s["idle"] = min(time.time() + SESSION_IDLE, s["max"])
            write_json(self.sess_file, d)
            return True

    def end_session(self, tok):
        with LOCK:
            d = self.sessions()
            d.pop(sha(tok or ""), None)
            write_json(self.sess_file, d)

    def login(self, user, password, code):
        a = read_json(self.admin_file, None)
        # always do the same work, so timing does not reveal what was wrong
        salt = bytes.fromhex(a["salt"]) if a else b"\0" * 16
        h = scrypt(password, salt)
        good_pw = a is not None and hmac.compare_digest(h.hex(), a["hash"])
        good_user = a is not None and hmac.compare_digest(user.strip().lower().encode(), a["user"].encode())
        good_code = False
        if a:
            now_step = int(time.time() // 30)
            code = "".join(ch for ch in code if ch.isdigit())
            with LOCK:
                a = read_json(self.admin_file, a)
                for st in (now_step - 1, now_step, now_step + 1):
                    if st > a.get("last", 0) and hmac.compare_digest(totp(a["totp"], st), code):
                        good_code = True
                        if good_pw and good_user:
                            a["last"] = st          # a code works only once
                            write_json(self.admin_file, a)
                        break
        return good_pw and good_user and good_code


