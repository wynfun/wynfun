class Limiter:
    """n tries per window seconds for a key (in memory)."""
    def __init__(self, n, window):
        self.n, self.w, self.d = n, window, {}

    def hit(self, key):
        now = time.time()
        v = [t for t in self.d.get(key, []) if now - t < self.w]
        self.d[key] = v
        if len(v) >= self.n:
            return False
        v.append(now)
        return True

    def peek(self, key):
        now = time.time()
        return len([t for t in self.d.get(key, []) if now - t < self.w]) < self.n

    def clear(self, key):
        self.d.pop(key, None)


