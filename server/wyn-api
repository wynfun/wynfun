            if not app.players.chat_lim.hit(p["id"]):
                return self.send(429, {"error": "slow down"})
            try:
                seq = int(body.get("seq") or 0)
            except Exception:
                seq = 0
            out = app.players.chat_player_sync(p["id"], seq, body.get("add"), body.get("mode"), bool(body.get("read")))
            return self.send(429 if out.get("error") else 200, out)
        if self.path == "/api/admin/chat/sync":
            if not self.admin_ok():
                return self.send(401, {"error": "sign in"})
            try:
                since = int(body.get("since") or 0)
            except Exception:
                since = 0
            return self.send(200, app.players.chat_admin_sync(since, body.get("add"), body.get("modes")))
        if self.path in ("/api/plinko/drop", "/api/wheel/spin", "/api/gem/start", "/api/gem/pick", "/api/gem/cash", "/api/gem/leave", "/api/crash/start", "/api/crash/cash", "/api/crash/cancel", "/api/battle", "/api/upgrade"):
            p = app.players.session_player(self.pcookie_val())
            if not p:
                return self.send(401, {"error": "sign in"})
            if not app.players.game_lim.hit(p["id"]):
                return self.send(429, {"error": "Slow down a little and try again."})
            pid, P = p["id"], app.players
            if self.path == "/api/plinko/drop":
                out, err = P.plinko_drop(pid, body.get("bet"), body.get("rows"), str(body.get("risk", ""))[:6])
            elif self.path == "/api/wheel/spin":
                out, err = P.wheel_spin(pid, body.get("bet"), body.get("n"), str(body.get("risk", ""))[:6])
            elif self.path == "/api/gem/start":
                out, err = P.gem_start(pid, body.get("bet"), body.get("mines"))
            elif self.path == "/api/gem/pick":
                out, err = P.gem_pick(pid, body.get("i"))
            elif self.path == "/api/gem/cash":
                out, err = P.gem_cash(pid)
            elif self.path == "/api/gem/leave":
                out, err = P.gem_leave(pid)
            elif self.path == "/api/crash/start":
                out, err = P.crash_start(pid, body.get("bet"), body.get("auto"))
