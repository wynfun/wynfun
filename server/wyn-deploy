#!/usr/bin/env bash
# wyn-deploy <live|staging> [--force]
# Publishes a branch from the GitHub repo to the web folder.
#   live    <- branch "main"
#   staging <- branch "staging"
# Every publish is a new numbered folder, so going back is instant.
set -euo pipefail
BASE="${WYN_BASE:-/srv/wynfun}"
REPO="${WYN_REPO:-/opt/wynfun-repo}"
KEEP="${WYN_KEEP:-10}"
ENVN="${1:-}"; FORCE="${2:-}"
case "$ENVN" in live) BR=main;; staging) BR=staging;; *) echo "usage: wyn-deploy <live|staging> [--force]"; exit 2;; esac
mkdir -p "$BASE/releases/$ENVN"
exec 9>"$BASE/.lock-$ENVN"; flock -n 9 || { echo "another deploy is running"; exit 0; }
cd "$REPO"
git fetch -q origin "$BR"
SHA="$(git rev-parse "origin/$BR")"
CUR="$(cat "$BASE/$ENVN.sha" 2>/dev/null || true)"
if [ "$SHA" = "$CUR" ] && [ "$FORCE" != "--force" ]; then exit 0; fi
REL="$BASE/releases/$ENVN/$(date -u +%Y%m%d-%H%M%S)-${SHA:0:7}"
mkdir -p "$REL"
trap 'rm -rf "$REL"' ERR
git archive "$SHA" | tar -x -C "$REL"
# keep server tooling and repo notes out of the public web folder
rm -rf "$REL/server" "$REL/README.md" "$REL/.gitignore" "$REL/.github"
[ -s "$REL/index.html" ] || { echo "no index.html in $BR, not publishing"; exit 1; }
trap - ERR
ln -sfn "$REL" "$BASE/$ENVN.new"
mv -Tf "$BASE/$ENVN.new" "$BASE/$ENVN"
echo "$SHA" > "$BASE/$ENVN.sha"
echo "$(date -u +%FT%TZ) $ENVN -> ${SHA:0:7}" >> "$BASE/deploy.log"
echo "published $ENVN: ${SHA:0:7}"
# keep only the newest releases
ls -1d "$BASE/releases/$ENVN"/* | sort | head -n -"$KEEP" | xargs -r rm -rf
